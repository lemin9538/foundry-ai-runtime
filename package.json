{
  "name": "foundry-ai-runtime",
  "version": "0.1.0",
  "description": "Shared structured-generation runtime for OpenAI-compatible APIs, Codex CLI, and Claude Code CLI",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/lemin9538/foundry-ai-runtime.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke:codex": "npm run build && node scripts/smoke-codex.mjs",
    "smoke:claude": "npm run build && node scripts/smoke-claude.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.27",
    "ai": "^7.0.58"
  },
  "peerDependencies": {
    "ai-sdk-provider-claude-code": "^4.0.1",
    "ai-sdk-provider-codex-cli": "^2.1.2",
    "zod": "^4.1.8"
  },
  "peerDependenciesMeta": {
    "ai-sdk-provider-claude-code": {
      "optional": true
    },
    "ai-sdk-provider-codex-cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ai-sdk-provider-claude-code": "^4.0.1",
    "ai-sdk-provider-codex-cli": "^2.1.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
